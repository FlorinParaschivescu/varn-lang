budget[steps=300]

rec Contact(kind:str,address:str)
rec Customer(name:str,primary:Contact,backup:Contact?)
rec Route(target:str,viaBackup:bool)

fn main(customer:Customer)->result[Route]
    if let backup:Contact customer.backup
        if eq(backup.kind,"email")
            ret ok(rec[Route](target=backup.address,viaBackup=true))
        end
    end
    if eq(customer.primary.kind,"email")
        ret ok(rec[Route](target=customer.primary.address,viaBackup=false))
    end
    ret err[Route](str.concat("no email contact for ",customer.name))
end
