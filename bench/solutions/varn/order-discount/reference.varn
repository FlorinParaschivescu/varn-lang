budget[steps=400]

rec Order(items:list[i64],customerTier:str)
rec Settlement(total:i64,discount:i64)

fn rate(tier:str)->result[i64]
    if eq(tier,"gold")
        ret ok(10)
    end
    if eq(tier,"silver")
        ret ok(5)
    end
    if eq(tier,"basic")
        ret ok(0)
    end
    ret err[i64](str.concat("unknown tier: ",tier))
end

fn main(order:Order)->result[Settlement]
    var total:i64 0
    each item:i64 in order.items max 32
        set total add(total,item)
    end
    if ok percent:i64 rate(order.customerTier)
        if ok discount:i64 num.div(mul(total,percent),100)
            ret ok(rec[Settlement](total=total,discount=discount))
        else err reason:str
            ret err[Settlement](reason)
        end
    else err reason:str
        ret err[Settlement](reason)
    end
end
