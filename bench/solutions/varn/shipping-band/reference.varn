budget[steps=200]

rec Parcel(grams:i64,express:bool)
rec Quote(cost:i64)

fn band(grams:i64)->i64
    if lte(grams,1000)
        ret 500
    end
    if lte(grams,5000)
        ret 900
    end
    ret 1500
end

fn main(parcel:Parcel)->result[Quote]
    if lt(parcel.grams,0)
        ret err[Quote]("negative weight")
    end
    let cost:i64 band(parcel.grams)
    if parcel.express
        ret ok(rec[Quote](cost=mul(cost,2)))
    end
    ret ok(rec[Quote](cost=cost))
end
