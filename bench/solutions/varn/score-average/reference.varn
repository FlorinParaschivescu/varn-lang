budget[steps=400]

rec Scores(values:list[i64])
rec Average(mean:i64,count:i64)

fn main(scores:Scores)->result[Average]
    let count:i64 list.length(scores.values)
    if eq(count,0)
        ret err[Average]("no scores")
    end
    var total:i64 0
    each value:i64 in scores.values max 32
        set total add(total,value)
    end
    if ok mean:i64 num.div(total,count)
        ret ok(rec[Average](mean=mean,count=count))
    else err reason:str
        ret err[Average](reason)
    end
end
