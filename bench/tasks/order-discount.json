{
  "id": "order-discount",
  "title": "Tiered order discount",
  "prompt": "Sum the order line amounts to a total. Apply a percentage discount by customer tier: gold 10 percent, silver 5 percent, basic 0 percent. The discount is a whole number of currency units, truncated toward zero. Any other tier is an error naming the tier as \"unknown tier: <tier>\". Return the total and the discount.",
  "contract": {
    "input": "Order(items:list[i64], customerTier:str)",
    "result": "result[Settlement(total:i64, discount:i64)]"
  },
  "cases": [
    {
      "name": "gold",
      "input": {
        "items": [
          1200,
          850,
          300
        ],
        "customerTier": "gold"
      },
      "expect": {
        "ok": true,
        "value": {
          "total": 2350,
          "discount": 235
        }
      }
    },
    {
      "name": "silver",
      "input": {
        "items": [
          1000
        ],
        "customerTier": "silver"
      },
      "expect": {
        "ok": true,
        "value": {
          "total": 1000,
          "discount": 50
        }
      }
    },
    {
      "name": "basic",
      "input": {
        "items": [
          500
        ],
        "customerTier": "basic"
      },
      "expect": {
        "ok": true,
        "value": {
          "total": 500,
          "discount": 0
        }
      }
    },
    {
      "name": "empty-order",
      "input": {
        "items": [],
        "customerTier": "gold"
      },
      "expect": {
        "ok": true,
        "value": {
          "total": 0,
          "discount": 0
        }
      }
    },
    {
      "name": "truncates-not-rounds",
      "input": {
        "items": [
          1205
        ],
        "customerTier": "gold"
      },
      "expect": {
        "ok": true,
        "value": {
          "total": 1205,
          "discount": 120
        }
      },
      "trap": "10 percent of 1205 is 120.5; the discount must truncate to 120, not round or stay fractional"
    },
    {
      "name": "unknown-tier",
      "input": {
        "items": [
          100
        ],
        "customerTier": "platinum"
      },
      "expect": {
        "ok": false,
        "error": "unknown tier: platinum"
      }
    },
    {
      "name": "tier-is-case-sensitive",
      "input": {
        "items": [
          100
        ],
        "customerTier": "Gold"
      },
      "expect": {
        "ok": false,
        "error": "unknown tier: Gold"
      },
      "trap": "tier matching is exact; \"Gold\" is not \"gold\""
    }
  ]
}
