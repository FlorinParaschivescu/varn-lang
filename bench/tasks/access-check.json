{
  "id": "access-check",
  "title": "Access decision",
  "prompt": "Decide whether a request is allowed. Allow when the role begins with \"admin\". Otherwise allow only when an age is present, the age is at least 18, and the region is exactly \"EU\". Return the decision and a reason: \"admin role\", \"adult in region\", or \"denied\".",
  "contract": {
    "input": "Request(role:str, age:i64?, region:str)",
    "result": "Decision(allowed:bool, reason:str)"
  },
  "cases": [
    {
      "name": "admin-prefix",
      "input": {
        "role": "administrator",
        "age": null,
        "region": "US"
      },
      "expect": {
        "allowed": true,
        "reason": "admin role"
      },
      "trap": "\"administrator\" begins with \"admin\", so it is allowed by prefix, not equality"
    },
    {
      "name": "adult-in-eu",
      "input": {
        "role": "member",
        "age": 30,
        "region": "EU"
      },
      "expect": {
        "allowed": true,
        "reason": "adult in region"
      }
    },
    {
      "name": "exactly-eighteen",
      "input": {
        "role": "member",
        "age": 18,
        "region": "EU"
      },
      "expect": {
        "allowed": true,
        "reason": "adult in region"
      },
      "trap": "18 is at least 18"
    },
    {
      "name": "under-age",
      "input": {
        "role": "member",
        "age": 17,
        "region": "EU"
      },
      "expect": {
        "allowed": false,
        "reason": "denied"
      }
    },
    {
      "name": "absent-age",
      "input": {
        "role": "member",
        "age": null,
        "region": "EU"
      },
      "expect": {
        "allowed": false,
        "reason": "denied"
      },
      "trap": "an absent age must not be treated as zero or as satisfying the check"
    },
    {
      "name": "wrong-region",
      "input": {
        "role": "member",
        "age": 30,
        "region": "eu"
      },
      "expect": {
        "allowed": false,
        "reason": "denied"
      },
      "trap": "region matching is exact and case-sensitive"
    }
  ]
}
