# A compound business rule as one expression: no helper function per condition.
budget[steps=300]

rec Order(items:list[i64],customerTier:str)
rec Settlement(total:i64,discount:i64,note:str)

fn main(order:Order)->Settlement
    var total:i64 0
    each item:i64 in order.items max 16
        set total add(total,item)
    end
    let favoured:bool or(eq(order.customerTier,"gold"),str.starts_with(order.customerTier,"vip"))
    if and(gte(total,1000),favoured)
        ret rec[Settlement](total=total,discount=div(mul(total,10),100),note=str.concat("tier ",order.customerTier))
    end
    ret rec[Settlement](total=total,discount=0,note="no discount")
end
