# Structured input all the way down: a list of records, nested records, and a built list.
budget[steps=600]

rec Line(sku:str,qty:i64,unitCents:i64)
rec Cart(lines:list[Line],tier:str)
rec Invoice(subtotalCents:i64,discountCents:i64,freeSkus:list[str])

fn lineTotal(line:Line)->i64
    ret line.qty * line.unitCents
end

fn main(cart:Cart)->result[Invoice]
    var subtotal:i64 0
    var free:list[str] list()
    each line:Line in cart.lines max 64
        if line.qty < 0
            ret err(str.concat("negative quantity for sku ",line.sku))
        end
        set subtotal subtotal + lineTotal(line)
        if line.unitCents == 0
            set free list.append(free,line.sku)
        end
    end
    if cart.tier == "gold"
        if ok discount:i64 num.div(subtotal,10)
            ret ok(rec[Invoice](subtotalCents=subtotal,discountCents=discount,freeSkus=free))
        else err reason:str
            ret err(reason)
        end
    end
    ret ok(rec[Invoice](subtotalCents=subtotal,discountCents=0,freeSkus=free))
end
