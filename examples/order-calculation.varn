# Reusable business rule. The order data arrives from the host, never from this source.
budget[steps=300]

rec Order(items:list[i64],customerTier:str)
rec Settlement(total:i64,discount:i64)

fn total(items:list[i64])->i64
    var sum:i64 0
    each item:i64 in items max 16
        set sum add(sum,item)
    end
    ret sum
end

fn rate(tier:str)->i64
    if eq(tier,"gold")
        ret 10
    end
    ret 0
end

fn main(order:Order)->Settlement
    let amount:i64 total(order.items)
    let percent:i64 rate(order.customerTier)
    ret rec[Settlement](total=amount,discount=div(mul(amount,percent),100))
end
