# Closed structured input and output without ambient object access.
budget[steps=300]

rec Order(items:list[i64],tier:str)
rec Settlement(total:i64,discount:i64)

fn total(items:list[i64])->i64
    var sum:i64 0
    each item:i64 in items max 8
        set sum sum + item
    end
    ret sum
end

fn discount(amount:i64,tier:str)->i64
    if tier == "gold"
        ret amount / 10
    end
    ret 0
end

fn settle(order:Order)->Settlement
    let amount:i64 total(order.items)
    let reduction:i64 discount(amount,order.tier)
    ret rec[Settlement](total=amount,discount=reduction)
end

fn main()->i64
    let order:Order rec[Order](items=list[i64](1200,850,300),tier="gold")
    let settlement:Settlement settle(order)
    ret settlement.discount
end
