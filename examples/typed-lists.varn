budget[steps=200]

fn sum(values:list[i64])->i64
    var total:i64 0
    each value:i64 in values max 4
        set total total + value
    end
    ret total
end

fn main()->i64
    let values:list[i64] list[i64](1,2,3,4)
    let beyondEnd:i64? list.get(values,9)
    if let present:i64 beyondEnd
        ret -1
    else
        ret sum(values)
    end
end
