# An expected failure is a value the caller must handle, not a crash. 'if ok' is the only way in.
budget[steps=400]

rec Order(items:list[i64],tier:str)
rec Settlement(total:i64,discount:i64)

fn rate(tier:str)->result[i64]
    if tier == "gold"
        ret ok(10)
    end
    if tier == "basic"
        ret ok(0)
    end
    ret err(str.concat("unknown tier: ",tier))
end

fn main(order:Order)->result[Settlement]
    var total:i64 0
    each item:i64 in order.items max 32
        set total total + item
    end
    if ok percent:i64 rate(order.tier)
        if ok discount:i64 num.div(total * percent,100)
            ret ok(rec[Settlement](total=total,discount=discount))
        else err reason:str
            ret err(reason)
        end
    else err reason:str
        ret err(reason)
    end
end
